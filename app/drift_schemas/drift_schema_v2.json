      "name": "recurring_payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_payments\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"next_payment_date\" TEXT NOT NULL, \"billing_cadence\" TEXT NOT NULL DEFAULT 'monthly', \"billing_month\" INTEGER NULL, \"billing_day\" INTEGER NOT NULL, \"payment_method_nickname\" TEXT NULL, \"category\" TEXT NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"created_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "payment_occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payment_occurrences\" (\"id\" TEXT NOT NULL, \"recurring_payment_id\" TEXT NOT NULL REFERENCES recurring_payments (id), \"payment_name\" TEXT NOT NULL, \"expected_date\" TEXT NOT NULL, \"expected_amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"actual_amount_minor\" INTEGER NULL, \"confirmed_at_utc\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"recurring_payment_id\", \"expected_date\"));"
        }
      ]
